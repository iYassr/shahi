node_modules/
dist/
*.log

# bun.lock is the lockfile. Expo's CLI reaches for npm when it cannot see one
# beside the project and leaves this behind, and the layout npm produces broke
# the web build once.
package-lock.json

# Secrets: VAPID keypair, passcode hash, cookie signing key
.env
.env.*
!.env.example

# Runtime state: transcript ring buffers and push subscriptions.
# Contains captured terminal output — never commit.
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Expo
mobile/.expo/
mobile/android/
mobile/ios/
e2e/.auth/
e2e/.server-gone
e2e/test-results/
test-results/
# Playwright's HTML reports, at any depth: a failed run copies its traces and
# error text into them, and a failed `live` run's hold the passcode login and
# real session responses.
playwright-report/

# Incremental typecheck state, regenerated on every run.
*.tsbuildinfo

# Expo: generated route types and dev-server state.
mobile/.expo/

# Generated at the root by eas-cli when run from the wrong directory.
/eas.json

# Independent /pwa build output.
web/dist-hosted/

# Local Cloudflare development state.
.wrangler/

# Finder metadata
.DS_Store

# Per-install runtime verification marker.
/.shahi-build

# Private paperwork and review credentials belong outside the repository.
/output/
/private/
/secrets/
*.pdf
*.eml
*.p8
*.p12
*.pfx
*.key
*.mobileprovision
credentials.json
reviewer-access.md
local.env
*-device.json
