node_modules/
dist/
*.log

# bun.lock is the lockfile. Expo's CLI reaches for npm when it cannot see one
# beside the project and leaves this behind, and the layout npm produces broke
# the web build once.
package-lock.json

# Secrets: VAPID keypair, passcode hash, cookie signing key
.env
.env.*
!.env.example

# Runtime state: transcript ring buffers and push subscriptions.
# Contains captured terminal output — never commit.
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Expo
mobile/.expo/
mobile/android/
mobile/ios/
e2e/.auth/
e2e/.server-gone
e2e/test-results/
test-results/

# Incremental typecheck state, regenerated on every run.
*.tsbuildinfo

# Expo: generated route types and dev-server state.
mobile/.expo/
