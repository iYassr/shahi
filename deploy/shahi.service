# Shahi — user service.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/shahi.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now shahi
#
# `loginctl enable-linger operator` is what keeps this running when you are not
# logged in — without it the service stops the moment your last SSH session ends,
# which is precisely when you would want to reach it from a phone.

[Unit]
Description=Shahi — mobile dashboard for herdr
Documentation=https://herdr.dev/docs/socket-api/
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Shahi
Environment=WEB_ROOT=%h/Shahi/web/dist
# Bound to this node's Tailscale address so the tailnet can reach it directly.
#
# Deliberately not 0.0.0.0: that would also publish on the LAN. And deliberately
# not loopback, which would need `tailscale serve` in front — that variant is
# the one that keeps Web Push working, since only a secure context may register
# a service worker. Swap back to 127.0.0.1 if you want notifications.
Environment=HOST=100.100.100.100
ExecStart=%h/.bun/bin/bun run server/index.ts
Restart=always
RestartSec=3

# herdr's socket lives under ~/.config, and the transcript database under
# ~/.local/share. Nothing else needs writing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/shahi
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
