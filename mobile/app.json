{
  "expo": {
    "name": "Shahi",
    "slug": "shahi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shahi",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.shahi.mobile",
      "infoPlist": {
        "_comment_encryption": "The SSH module bundles OpenSSL and does general-purpose encryption, so this is 'true' — 'false' would be a false declaration. Standard/mass-market crypto (SSH, TLS) qualifies for the export exemption; ANSWER the export-compliance questions in App Store Connect accordingly at submission (or supply the self-classification report). See docs/app-store.md.",
        "ITSAppUsesNonExemptEncryption": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14120F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.shahi.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0D0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fa81100f-5f3c-4c44-898b-4ecd740a84e9"
      },
      "router": {}
    },
    "owner": "yasserd99",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fa81100f-5f3c-4c44-898b-4ecd740a84e9"
    }
  }
}
