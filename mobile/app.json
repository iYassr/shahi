{
  "expo": {
    "name": "Shahi",
    "slug": "shahi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shahi",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.shahi.mobile",
      "infoPlist": {
        "_comment_encryption": "The app bundles SSH and relay cryptography. Omit the encryption declaration keys so App Store Connect asks for the actual build and distribution scope. France is excluded from the initial release. Complete the questionnaire for every build; see docs/app-store.md.",
        "_comment_ats": "The only cleartext this app makes is to 127.0.0.1, the local end of the SSH tunnel — the relay is https. So the exception is the narrow one: NSAllowsLocalNetworking covers loopback and leaves ATS enforced for every other host. It was NSAllowsArbitraryLoads while a typed tailnet address was a way in (no fixed domain could be whitelisted); that transport is gone, and a blanket exception is the hardest kind to justify at review. See docs/app-store.md.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDiagnosticData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0D0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.shahi.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shahi attaches a photo from your library to send to the agent you are talking to.",
          "_comment": "Library only (launchImageLibraryAsync). Without microphonePermission false this plugin writes Expo's placeholder NSMicrophoneUsageDescription and RECORD_AUDIO back after expo-camera removed them (pre-release review). cameraPermission stays unset on purpose: false would delete the camera string and permission the pairing scanner needs.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0D0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-secure-store",
        {
          "_comment": "Nothing is kept behind biometrics (no requireAuthentication), so no placeholder Face ID purpose string (pre-release review).",
          "faceIDPermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Shahi uses the camera to scan the pairing code your server prints.",
          "_comment": "Scanning only: no microphone string and no RECORD_AUDIO, so the app never claims a permission it has no use for.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fa81100f-5f3c-4c44-898b-4ecd740a84e9"
      },
      "router": {}
    },
    "owner": "yasserd99",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/fa81100f-5f3c-4c44-898b-4ecd740a84e9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
