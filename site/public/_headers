/*
  # no-transform stops Cloudflare injecting its analytics beacon into HTML
  # (docs/operations.md), and it also turns off Cloudflare's compression: every
  # text file went out uncompressed, the PWA's 548 KB bundle included (measured
  # on getshahi.dev, 2026-09-25). Injection only touches HTML, so HTML keeps it
  # here, and the non-HTML text below replaces it so the edge can compress it.
  Cache-Control: public, no-transform
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # includeSubDomains, as the relay sends (pre-release bug hunt, B51). Sent
  # whatever the scheme, since a rule cannot see it; the zone's "Always Use
  # HTTPS" redirects before a plain-HTTP request reaches this (docs/relay.md).
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

/pwa/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' wss:; worker-src 'self'; manifest-src 'self'; media-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  # Rules match the requested path, not the _redirects rewrite behind it, so a
  # rule for /pwa/ alone served /pwa/pane/* and every other app route the same
  # HTML with nothing telling a cache to revalidate it (found in the 2026-09-22
  # pre-release review). Everything unhashed here revalidates.
  Cache-Control: no-cache

/pwa/assets/*
  # Hashed names are the only files whose content never changes. The rule
  # above would otherwise be joined into this header, and no-cache would win.
  # A missing file's 404 page (HTML) takes this rule too, so it goes without
  # no-transform: there the /pwa/* policy's script-src 'self' and 404.html's
  # own default-src 'none' are what refuse an injected beacon, and
  # e2e/hosted/pwa.spec.ts checks the first.
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pwa/sw.js
  Cache-Control: no-store
  Service-Worker-Allowed: /pwa/

# The site's other text, by exact path so no 404 page (HTML) matches: revalidated,
# as their names carry no hash, and without no-transform, so they are compressed.
# e2e/hosted/pwa.spec.ts fails for a CSS, JavaScript or SVG file here that is missing
# from this list.
/site.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/identity.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/privacy.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/beta.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/launch.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/welcome.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/wordmark.svg
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/fonts/plex.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/agents/claude.svg
