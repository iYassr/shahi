/og.png
  # The link-preview card: LinkedIn, Reddit and chat apps fetch or embed it
  # from their own origins, which same-origin resource policy would refuse.
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/
  # media-src: the launch video and its captions, from /media/ on this origin
  # (site/src/media.ts). Without it both engines refused the video, even with
  # preload="none", since the policy is checked when a source is chosen.
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'

/privacy
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/privacy.html
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
